{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "founders-dev-local",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-05-10",
  "compatibility_flags": ["nodejs_compat"],

  // Local review only: no account is selected and hosted URLs are disabled.
  "workers_dev": false,

  // Static asset directory produced by `vite build` for the TanStack Start
  // client bundle. The Vite Cloudflare plugin writes here.
  "assets": {
    "directory": "./dist/client",
  },

  // Surface logs in the Cloudflare dashboard. Cheap insurance.
  "observability": {
    "enabled": true,
  },

  // Non-secret env vars. Anything secret (EMAILIT_API_KEY, OPENROUTER_API_KEY,
  // SUPABASE_SERVICE_ROLE_KEY, SEND_EMAIL_HOOK_SECRET, EMAILIT_WEBHOOK_SECRET)
  // goes in via `wrangler secret put NAME` — never in this file.
  "vars": {
    "EMAILIT_SENDER_DOMAIN": "example.invalid",
    "SITE_ROOT_DOMAIN": "localhost",
  },
}
